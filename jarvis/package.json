{
  "name": "jarvis",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:artifact": "npm run build:single && node scripts/artifact.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.6.3",
    "vite": "^6.3.5",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^3.2.4"
  }
}